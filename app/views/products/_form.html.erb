<%= form_with model: product, class: "form-card" do |form| %>
  <%= render "shared/form_errors", record: product %>
<div class="mb-3">
  <%= form.label :image, "Gambar", class: "form-label" %>
  <% if product.image.attached? %>
    <div class="mb-2">
      <%= image_tag product.image, alt: product.name, style: "max-width: 12rem; border-radius: 1rem;" %>
    </div>
  <% end %>
  <%= form.file_field :image, accept: "image/png,image/jpeg,image/webp", class: "form-control" %>
  <div class="form-text">JPG, PNG, atau WebP. Maksimal 5 MB.</div>
</div>

  <div class="mb-3">
    <%= form.label :name, "Nama", class: "form-label" %>
    <%= form.text_field :name, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= form.label :description, "Deskripsi", class: "form-label" %>
    <%= form.text_area :description, rows: 4, class: "form-control" %>
  </div>
  <div class="row g-3 mb-3">
    <div class="col-12 col-sm-7">
      <%= form.label :price, "Harga", class: "form-label" %>
      <div class="input-group">
        <span class="input-group-text">Rp</span>
        <%= form.number_field :price, min: 0, class: "form-control" %>
      </div>
    </div>
    <div class="col-12 col-sm-5">
      <%= form.label :stock, "Stok", class: "form-label" %>
      <%= form.number_field :stock, min: 0, class: "form-control" %>
    </div>
  </div>
  <div class="mb-4">
    <%= form.label :category_id, "Kategori", class: "form-label" %>
    <%= form.collection_select :category_id, Category.order(:name), :id, :name,
          { include_blank: "-- Tanpa kategori --" }, class: "form-select" %>
  </div>
  <div class="d-flex align-items-center gap-3">
    <%= form.submit(product.new_record? ? "Simpan" : "Simpan Perubahan", class: "btn btn-ink") %>
    <%= link_to "Batal", (product.persisted? ? product : products_path), class: "btn-text" %>
  </div>
<% end %>
