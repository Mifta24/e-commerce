<h1>Daftar Produk</h1>
<% if notice %>
  <p style="color: green;"><%= notice %></p>
<% end %>

<p><%= link_to "Tambah Produk", new_product_path %></p>
<% if @products.any? %>
  <ul>
    <% @products.each do |product| %>
      <li>
        <%= link_to product.name, product_path(product) %> -
        Rp<%= number_with_delimiter(product.price, delimiter: ".") %>
        (stok: <%= product.stock %>)
      </li>
    <% end %>
  </ul>
<% else %>
  <p>Belum ada produk.</p>
<% end %>
