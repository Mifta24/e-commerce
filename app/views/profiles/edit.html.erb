<% content_for :title, "Ubah Data | E Commerce" %>

<div class="page-header">
  <div>
    <p class="eyebrow mb-1">Akun</p>
    <h1 class="section-title"><strong>Ubah Data</strong></h1>
  </div>
</div>

<%= form_with model: @user, url: profile_path, method: :patch, class: "form-card" do |form| %>
  <%= render "shared/form_errors", record: @user %>

  <div class="mb-3">
    <%= form.label :name, "Nama", class: "form-label" %>
    <%= form.text_field :name, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= form.label :email_address, "Email", class: "form-label" %>
    <%= form.email_field :email_address, disabled: true, class: "form-control" %>
  </div>
  <div class="mb-4">
    <%= form.label :phone, "Telepon", class: "form-label" %>
    <%= form.telephone_field :phone, class: "form-control" %>
  </div>
  <div class="d-flex align-items-center gap-3">
    <%= form.submit "Simpan Perubahan", class: "btn btn-ink" %>
    <%= link_to "Batal", profile_path, class: "btn-text" %>
  </div>
<% end %>
