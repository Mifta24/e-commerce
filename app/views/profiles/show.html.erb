<% content_for :title, "Profil | E Commerce" %>

<div class="page-header">
  <div>
    <p class="eyebrow mb-1">Akun</p>
    <h1 class="section-title"><strong>Profil Saya</strong></h1>
  </div>
</div>

<div class="form-card mb-4">
  <dl class="row mb-0">
    <dt class="col-sm-4">Nama</dt>
    <dd class="col-sm-8"><%= @user.name %></dd>

    <dt class="col-sm-4">Email</dt>
    <dd class="col-sm-8"><%= @user.email_address %></dd>

    <dt class="col-sm-4">Telepon</dt>
    <dd class="col-sm-8 mb-0"><%= @user.phone.presence || "-" %></dd>
  </dl>
</div>

<div class="d-flex flex-wrap gap-2">
  <%= link_to "Ubah data", edit_profile_path, class: "btn btn-ink" %>
  <%= link_to "Ubah password", edit_password_change_path, class: "btn btn-outline-ink" %>
  <%= link_to "Alamat saya", addresses_path, class: "btn btn-outline-ink" %>
  <%= link_to "Pesanan saya", orders_path, class: "btn btn-outline-ink" %>
</div>
