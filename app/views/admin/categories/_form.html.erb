<%= form_with(model: [:admin, category], class: "form-card") do |form| %>

  <%= render "shared/form_errors", record: category %>

  <div class="mb-4">
    <%= form.label :name, "Nama", class: "form-label" %>
    <%= form.text_field :name, class: "form-control" %>
  </div>

  <div class="d-flex align-items-center gap-3">
    <%= form.submit(category.new_record? ? "Simpan" : "Simpan Perubahan", class: "btn btn-ink") %>
    <%= link_to "Batal", admin_categories_path, class: "btn-text" %>

  </div>
<% end %>
