<% content_for :title, "Kelola Kategori | E Commerce" %>

<div class="page-header">
  <div>
    <p class="eyebrow mb-1">Admin · <%= @categories.length %> kategori</p>
    <h1 class="section-title"><strong>Kelola Kategori</strong></h1>
  </div>
  <%= link_to new_admin_category_path, class: "btn btn-ink" do %><i class="bi bi-plus-lg me-1"></i>Tambah Kategori<% end %>
</div>

<% if @categories.any? %>
  <table class="table align-middle">
    <thead>
      <tr>
        <th>Nama</th>
        <th class="text-end">Produk</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @categories.each do |category| %>
        <tr>
          <td><%= link_to category.name, category_path(category) %></td>
          <td class="text-end">
            <%= link_to category.jumlah_produk, admin_products_path(category: category.id) %>
          </td>
          <td class="text-end text-nowrap">
            <%= link_to "Edit", edit_admin_category_path(category), class: "me-2" %>
            <%= button_to "Hapus", admin_category_path(category), method: :delete,
                  class: "btn btn-link btn-sm text-danger p-0 align-baseline",
                  form: { class: "d-inline", data: { turbo_confirm: pesan_hapus_kategori(category) } } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="text-center text-body-secondary py-5">Belum ada kategori.</p>
<% end %>
