<% content_for :title, "Kelola Produk | E Commerce" %>

<div class="page-header">
  <div>
    <p class="eyebrow mb-1">Admin · <%= @products.total_count %> produk</p>
    <h1 class="section-title"><strong>Kelola Produk</strong></h1>
  </div>
  <%= link_to new_admin_product_path, class: "btn btn-ink" do %><i class="bi bi-plus-lg me-1"></i>Tambah Produk<% end %>
</div>

<%= form_with url: admin_products_path, method: :get, class: "row g-2 mb-4" do |form| %>
  <div class="col-12 col-md-5">
    <%= form.search_field :q, value: params[:q], placeholder: "Cari nama atau deskripsi...", class: "form-control" %>
  </div>
  <div class="col-6 col-md-3">
    <%= form.select :category, options_from_collection_for_select(@categories, :id, :name, @selected_category&.id),
          { include_blank: "Semua kategori" }, class: "form-select" %>
  </div>
  <div class="col-6 col-md-2">
    <%= form.select :stok,
          options_for_select([ [ "Stok menipis", "menipis" ], [ "Stok habis", "habis" ] ], params[:stok]),
          { include_blank: "Semua stok" }, class: "form-select" %>
  </div>
  <div class="col-12 col-md-2 d-flex gap-2">
    <%= form.submit "Filter", class: "btn btn-ink flex-grow-1" %>
    <%= link_to "Reset", admin_products_path, class: "btn-text align-self-center" %>
  </div>
<% end %>

<% if @products.any? %>
  <div class="table-responsive">
    <table class="table align-middle">
      <thead>
        <tr>
          <th></th>
          <th>Nama</th>
          <th>Kategori</th>
          <th class="text-end">Harga</th>
          <th class="text-end">Stok</th>
          <th class="text-end" title="Jumlah pengguna yang memfavoritkan">Favorit</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @products.each do |product| %>
          <tr>
            <td style="width: 4rem;">
              <% if product.image.attached? %>
                <%= image_tag product.image, alt: product.name, style: "width: 3rem; height: 3rem; object-fit: cover; border-radius: .75rem;" %>
              <% else %>
                <div class="tile--<%= tone_for(product) %> d-flex align-items-center justify-content-center"
                     style="width: 3rem; height: 3rem; border-radius: .75rem;"><i class="bi bi-bag-heart"></i></div>
              <% end %>
            </td>
            <td><%= link_to product.name, product_path(product) %></td>
            <td><%= product.category&.name || "-" %></td>
            <td class="text-end"><%= rupiah(product.price) %></td>
            <td class="text-end">
              <% if product.stock.zero? %>
                <span class="badge text-bg-danger">Habis</span>
              <% elsif product.stock <= Product::LOW_STOCK %>
                <span class="badge text-bg-warning"><%= product.stock %></span>
              <% else %>
                <%= product.stock %>
              <% end %>
            </td>
            <td class="text-end"><%= product.favorites_count %></td>
            <td class="text-end text-nowrap">
              <%= link_to "Edit", edit_admin_product_path(product), class: "me-2" %>
              <%= button_to "Hapus", admin_product_path(product), method: :delete,
                    class: "btn btn-link btn-sm text-danger p-0 align-baseline",
                    form: { class: "d-inline", data: { turbo_confirm: "Yakin hapus #{product.name}?" } } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%= paginate @products %>
<% else %>
  <p class="text-center text-body-secondary py-5">
    <%= params.values_at(:q, :category, :stok).any?(&:present?) ? "Tidak ada produk yang cocok dengan filter." : "Belum ada produk." %>
  </p>
<% end %>
