<% content_for :title, "Kelola Pesanan | E Commerce" %>

<div class="page-header">
  <div>
    <p class="eyebrow mb-1">Admin</p>
    <h1 class="section-title"><strong>Kelola Pesanan</strong></h1>
  </div>
</div>

<div class="d-flex flex-wrap gap-2 mb-4">
  <%= link_to "Semua", admin_orders_path, class: "filter-pill #{'active' if @status.blank?}" %>
  <% Order.statuses.each_key do |status| %>
    <%= link_to order_status_label(status), admin_orders_path(status: status),
          class: "filter-pill #{'active' if @status == status}" %>
  <% end %>
</div>

<% if @orders.any? %>
  <table class="table align-middle">
    <thead>
      <tr>
        <th>No.</th>
        <th>Tanggal</th>
        <th>Pelanggan</th>
        <th>Status</th>
        <th>Total</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @orders.each do |order| %>
        <tr>
          <td>#<%= order.id %></td>
          <td><%= order.created_at.strftime("%d-%m-%Y %H:%M") %></td>
          <td><%= link_to order.user.name, admin_customer_path(order.user) %></td>
          <td>
            <%= order_status_badge(order) %>
          </td>
          <td><%= rupiah(order.total) %></td>
          <td><%= link_to "Lihat", admin_order_path(order) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <%= paginate @orders %>
<% else %>
  <p class="text-center text-body-secondary py-5">Belum ada pesanan.</p>
<% end %>
