<%= form_with model: @user, url: registration_path do |form| %>
  <% if @user.errors.any? %>
    <ul style="color:red">
      <% @user.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
    </ul>
  <% end %>

  <%= form.text_field :name, required: true, autofocus: true, placeholder: "Nama lengkap" %><br>
  <%= form.email_field :email_address, required: true, autocomplete: "username", placeholder: "Email" %><br>
  <%= form.password_field :password, required: true, autocomplete: "new-password", placeholder: "Password", maxlength: 72 %><br>
  <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: "Ulangi password", maxlength: 72 %><br>
  <%= form.submit "Sign up" %>
<% end %>

<%= link_to "Sudah punya akun? Sign in", new_session_path %>
