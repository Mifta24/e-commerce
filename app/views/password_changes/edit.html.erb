<% content_for :title, "Ubah Password | E Commerce" %>

<div class="page-header">
  <div>
    <p class="eyebrow mb-1">Akun</p>
    <h1 class="section-title"><strong>Ubah Password</strong></h1>
  </div>
</div>

<%= form_with model: @user, url: password_change_path, method: :patch, class: "form-card" do |form| %>
  <%= render "shared/form_errors", record: @user %>

  <div class="mb-3">
    <%= label_tag :current_password, "Password saat ini", class: "form-label" %>
    <%= password_field_tag :current_password, nil, class: "form-control",
          autocomplete: "current-password", required: true %>
  </div>
  <div class="mb-3">
    <%= form.label :password, "Password baru", class: "form-label" %>
    <%= form.password_field :password, class: "form-control",
          autocomplete: "new-password", required: true, minlength: 8, maxlength: 72 %>
    <div class="form-text">Minimal 8 karakter.</div>
  </div>
  <div class="mb-4">
    <%= form.label :password_confirmation, "Ulangi password baru", class: "form-label" %>
    <%= form.password_field :password_confirmation, class: "form-control",
          autocomplete: "new-password", required: true, minlength: 8, maxlength: 72 %>
  </div>
  <div class="d-flex align-items-center gap-3">
    <%= form.submit "Ubah Password", class: "btn btn-ink" %>
    <%= link_to "Batal", profile_path, class: "btn-text" %>
  </div>
<% end %>
