<% content_for :title, "Kategori | E Commerce" %>

<div class="page-header">
  <div>
    <p class="eyebrow mb-1"><%= @categories.size %> kategori</p>
    <h1 class="section-title"><strong>Kategori</strong></h1>
  </div>
 
</div>

<% if @categories.any? %>
  <div id="categories" class="row g-4">
    <% @categories.each do |category| %>
      <div class="col-12 col-sm-6 col-lg-4">
        <%= render category %>
      </div>
    <% end %>
  </div>
<% else %>
  <p class="text-center text-body-secondary py-5">Belum ada kategori.</p>
<% end %>
