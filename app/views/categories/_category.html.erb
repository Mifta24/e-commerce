<%= link_to category_path(category), id: dom_id(category), class: "category-card tile--#{tone_for(category)}" do %>
  <div class="category-name"><%= category.name %></div>
  <div class="category-count"><%= category.products.size %> produk</div>
  <i class="bi bi-tags tile-icon" aria-hidden="true"></i>
<% end %>
