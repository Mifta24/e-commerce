<% content_for :title, "#{@category.name} | E Commerce" %>

<nav class="mb-4"><%= link_to "← Kembali ke kategori", categories_path, class: "btn-text" %></nav>

<div class="page-header">
  <div>
    <p class="eyebrow mb-1"><%= @products.size %> produk</p>
    <h1 class="section-title"><strong><%= @category.name %></strong></h1>
  </div>
  
</div>

<% if @products.any? %>
  <div class="row g-4">
    <% @products.each do |product| %>
      <div class="col-6 col-md-4 col-lg-3">
        <%= render "products/card", product: product %>
      </div>
    <% end %>
  </div>
<% else %>
  <p class="text-center text-body-secondary py-5">Belum ada produk di kategori ini.</p>
<% end %>
