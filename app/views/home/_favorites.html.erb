<section class="favorites py-5" id="favorites">
  <h2 class="section-title text-center mb-4">Pilihan Favorit</h2>

  <%# Turbo Frame: klik filter hanya mengganti bagian ini, halaman tidak reload. %>
  <%= turbo_frame_tag "favorites_list" do %>
    <div class="d-flex flex-wrap justify-content-center gap-2 mb-4">
      <%= link_to "Semua", root_path, class: "filter-pill #{'active' unless @selected_category}" %>
      <% @categories.each do |category| %>
        <%= link_to category.name, root_path(category: category.id),
              class: "filter-pill #{'active' if category == @selected_category}" %>
      <% end %>
    </div>

    <% if @favorite_products.any? %>
      <div class="row g-4">
        <% @favorite_products.each do |product| %>
          <div class="col-6 col-lg-3">
            <%= render "products/card", product: product %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-center text-body-secondary py-4">Belum ada produk di kategori ini.</p>
    <% end %>
  <% end %>
</section>
