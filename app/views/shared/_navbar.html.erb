<nav class="navbar navbar-expand-lg site-nav">
  <div class="container">
    <%= link_to "E Commerce", root_path, class: "navbar-brand" %>
    <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
            aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="mainNav">
      <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
        <li class="nav-item"><%= link_to "Home", root_path, class: "nav-link #{'active' if current_page?(root_path)}" %></li>
        <li class="nav-item"><%= link_to "Produk", products_path, class: "nav-link #{'active' if controller_path == 'products'}" %></li>
        <li class="nav-item"><%= link_to "Kategori", categories_path, class: "nav-link #{'active' if controller_path == 'categories'}" %></li>
      </ul>

      <div class="nav-icons d-flex align-items-center gap-1">
        <%# Pencarian produk %>
        <div class="dropdown">
          <button class="btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Cari">
            <i class="bi bi-search"></i>
          </button>
          <div class="dropdown-menu dropdown-menu-end p-3" style="min-width: 280px;">
            <%= form_with url: products_path, method: :get do |form| %>
              <%= form.search_field :q, value: params[:q], placeholder: "Cari produk...", class: "form-control" %>
            <% end %>
          </div>
        </div>

        <%# Favorit %>
        <% jumlah_favorit = favorites_by_product.size %>
        <%= link_to favorites_path, class: "btn position-relative", title: "Favorit", aria: { label: "Favorit" } do %>
          <i class="bi bi-heart"></i>
          <% if jumlah_favorit > 0 %>
            <span class="badge rounded-pill bg-danger position-absolute top-0 start-100 translate-middle"><%= jumlah_favorit %></span>
          <% end %>
        <% end %>

        <%# Keranjang %>
        <% jumlah = current_cart ? current_cart.total_items : 0 %>
        <%= link_to cart_path, class: "btn position-relative", title: "Keranjang" do %>
          <i class="bi bi-bag"></i>
          <% if jumlah > 0 %>
            <span class="badge rounded-pill bg-danger position-absolute top-0 start-100 translate-middle"><%= jumlah %></span>
          <% end %>
        <% end %>

        <%# Akun %>
        <% if authenticated? %>
          <div class="dropdown">
            <button class="btn signin dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
              <i class="bi bi-person-circle me-1"></i><%= Current.user.name.split.first %>
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
              <li><span class="dropdown-item-text text-muted small"><%= Current.user.email_address %></span></li>
              <li><hr class="dropdown-divider"></li>
              <li><%= link_to "Profil Saya", profile_path, class: "dropdown-item" %></li>
              <li><%= link_to "Alamat Saya", addresses_path, class: "dropdown-item" %></li>
              <li><%= link_to "Pesanan Saya", orders_path, class: "dropdown-item" %></li>

              <%# Menu admin cukup satu pintu: semua halaman admin ada di sidebar dasbor %>
              <% if Current.user.admin? %>
                <% menunggu = Payment.submitted.count %>
                <li><hr class="dropdown-divider"></li>
                <li>
                  <%= link_to admin_root_path, class: "dropdown-item d-flex justify-content-between align-items-center" do %>
                    Dasbor Admin
                    <% if menunggu > 0 %><span class="badge text-bg-danger ms-3"><%= menunggu %></span><% end %>
                  <% end %>
                </li>
              <% end %>

              <li><hr class="dropdown-divider"></li>
              <li>
                <%= button_to session_path, method: :delete, class: "dropdown-item" do %>
                  <i class="bi bi-box-arrow-right me-1"></i>Sign out
                <% end %>
              </li>
            </ul>
          </div>
        <% else %>
          <%= link_to new_session_path, class: "btn signin" do %>
            <i class="bi bi-person me-1"></i>Sign in
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</nav>
